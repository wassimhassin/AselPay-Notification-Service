# Copy this file to .env and fill in the values.

# --- Server -----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# --- Security ---------------------------------------------------------------
# Shared secret: the AselPay backend sends it in the "x-api-key" header.
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Optional: comma-separated IPs allowed to call the /v1 API (the AselPay
# backend server). Leave empty to allow any IP (the API key is still required).
ALLOWED_IPS=

# Only if the service sits behind a reverse proxy (nginx...). Every request
# then comes from the proxy, so ALLOWED_IPS must be checked against the
# X-Forwarded-For header instead. "loopback" = proxy on the same machine.
# Leave empty if the backend calls the service directly (http://ip:port).
TRUST_PROXY=

# --- Expo -------------------------------------------------------------------
# Optional: only needed if "Enhanced push security" is enabled in the Expo
# project settings (expo.dev > project > Credentials / Access tokens).
EXPO_ACCESS_TOKEN=
EXPO_TIMEOUT_MS=15000

# --- Queue and retries --------------------------------------------------------
QUEUE_MAX_SIZE=50000
MAX_ATTEMPTS=8
RETRY_BASE_MS=2000
RETRY_MAX_MS=300000
MAX_TOKENS_PER_REQUEST=1000

# --- Delivery receipts --------------------------------------------------------
RECEIPT_DELAY_MINUTES=15
RECEIPT_INTERVAL_MINUTES=5

# --- Storage and logs ---------------------------------------------------------
# Folder for invalid-tokens.json and pending-queue.json (relative to the project).
DATA_DIR=data
# debug | info | warn | error
LOG_LEVEL=info
